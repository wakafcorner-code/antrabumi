# ANTRABUMI Environment Variables
# Copy this file to .env.local for local development.
# DO NOT commit .env or secrets to version control.

# ─── Application ──────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database ─────────────────────────────────────────────────────────────────
# MySQL 8+ connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://antrabumi:antrabumi@localhost:3306/antrabumi"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# ─── Storage ──────────────────────────────────────────────────────────────────
# Local storage (development) or S3-compatible (production)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="antrabumi-media"

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Used only during prisma db seed
SEED_ADMIN_EMAIL="admin@antrabumi.org"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
