# ==============================================================================
# ANTRABUMI - ENVIRONMENT VARIABLES EXAMPLE
# ==============================================================================

# 1. URL APLIKASI
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 2. KONEKSI DATABASE MYSQL
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Di cPanel HOST biasanya 'localhost' dan PORT '3306'
DATABASE_URL="mysql://username_cpanel_db:password_db@localhost:3306/nama_cpanel_db"

# 3. AUTHENTICATION SECRET
# String rahasia bebas minimal 32 karakter
AUTH_SECRET="ganti-dengan-kunci-acak-minimal-32-karakter-bebas"
